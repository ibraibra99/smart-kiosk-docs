1.8 — اشتقاق feature_plugin_data_map من السجلّ

الشدّة: ⚪ منخفض.
الإصلاح

dart
// lib/features/core/plugin_registry.dart
Map<String, List<String>> pluginDataMapFromRegistry() {
  final out = <String, List<String>>{};
  for (final FeaturePlugin p in buildPlugins()) {
    if (p.family.isEmpty || p.sub.isEmpty || p.intentKeys.isEmpty) continue;
    final String clean = '$`{p.sub}_`${p.family}';
    out[clean] = List<String>.unmodifiable(p.intentKeys);
    out['has_$`clean'] = List<String>.unmodifiable(p.intentKeys);
  }
  return out;
}


ودمجٌ لا استبدال: {...pluginDataMapFromRegistry(), ...rowyOverrides}.
(اليوم خريطة Rowy تستبدل الاحتياطيّ كلّياً، فناقصةٌ تُعطّل ميزاتٍ بصمت.)

